@page "/customer/profile/{guid:guid}"
@using System.Text.RegularExpressions;
@attribute [Authorize]
@inject ISweetAlertService swal
@inject ITextTranslator Text
@inject FieldExtractor<EntityVeternayCustomer> field
@inject Microsoft.JSInterop.IJSRuntime jSRuntime
@inject IVeternayCustomer _svc
@inject ISettingBookingService _svcBooking  
@inject IJSRuntime JS
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.Buttons
@using System.IO
@using System.Text
@using System.Text.Json
<SfDialog Target="#target" MinHeight="70%" Width="400px" Height="400px" class="dialog-create-employee" IsModal="true" ShowCloseIcon="true" @bind-Visible="_modalVisible">
    <DialogTemplates>
        <Header><span class="title">Phiếu đăng ký</span></Header>
        <Content>
            <EditForm id="editFormBooking" Model="@_modelBooking" OnValidSubmit="@OnFormSubmitBooking">
                <DataAnnotationsValidator />
               
                    <div class="row mt-4">
                    <div class="col-lg-6">
                        <SfDateTimePicker TValue="DateTime?"
                                          Placeholder="Chọn ngày và giờ"
                                          Format="dd/MM/yyyy HH:mm"
                                          Locale="vi"
                                          ShowClearButton="true"
                                          @bind-Value="@_modelBooking.AppointmentDate">
                        </SfDateTimePicker>
                        <CustomValidationMessage style="color: red;" For="@(() => _modelBooking.AppointmentDate)" />
                    </div>
                        <div class="col-lg-12 mb-3">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-success text-white fw-bold">
                                    Thú cưng
                                </div>
                                <div class="card-body">
                                @if (_selectedCustomer?.Pets?.Any() == true)
                                    {
                                    <SfDropDownList TValue="Guid" TItem="EntityveternayPet"
                                                    DataSource="@_selectedCustomer.Pets"
                                                        Placeholder="Chọn thú cưng"
                                                        @bind-Value="_selectedPet"
                                                        Width="100%">
                                            <DropDownListFieldSettings Text="Name" Value="Guid" />
                                        <DropDownListEvents TValue="Guid" TItem="EntityveternayPet" ValueChange="OnPetsChanged" />
                                        </SfDropDownList>

                                        @if (_selectedPets != null)
                                        {
                                            <div class="mt-3">
                                                <p><b>Tên:</b> @_selectedPets.Name</p>
                                                <p><b>Giới tính:</b> @_selectedPets.Gender</p>
                                                <p><b>Giống loài:</b> @_selectedPets.Species</p>
                                                <p><b>Tuổi:</b> @_selectedPets.Breed</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic">Khách hàng chưa có thú cưng nào.</p>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (_selectedPets != null)
                        {
                            <div class="col-lg-12">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-success text-white fw-bold">
                                        Dịch vụ
                                    </div>
                                    <div class="card-body">
                                        <SfMultiSelect TValue="Guid[]" TItem="ModelService" @bind-Value="_selectedService" Placeholder="Chọn dịch vụ" DataSource="@_optService" AllowFiltering="true">
                                            <MultiSelectFieldSettings Text="Name" Value="Guid"></MultiSelectFieldSettings>
                                            <MultiSelectEvents TValue="Guid[]" TItem="ModelService" ValueChange="@OnServiceChanged" />
                                        </SfMultiSelect>
                                        @if (_selectedServicesList?.Any() == true)
                                        {
                                            <div class="mt-3">
                                                <h6 class="fw-bold text-primary">Dịch vụ đã chọn:</h6>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-striped">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Tên dịch vụ</th>
                                                                <th class="text-end">Giá</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var service in _selectedServicesList)
                                                            {
                                                                <tr>
                                                                    <td>@service.Name</td>
                                                                    <td class="text-end">@service.Price.ToString("#,##0") VNĐ</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                        <tfoot class="table-warning">
                                                            <tr>
                                                                <th>Tổng cộng:</th>
                                                                <th class="text-end fw-bold text-danger">@_totalPrice.ToString("#,##0") VNĐ</th>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                <div class="form-group mt-4">
                    <label class="form-label fw-bold">Mô tả</label>
                    <InputTextArea rows="3" class="form-control" @bind-Value="_modelBooking.Notes" />
                    <CustomValidationMessage style="color: red;" For="@(() => _modelBooking.Notes)" />
                </div>

            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogEvents Closed="@OnModalClosedBooking"></DialogEvents>
    <DialogButtons>
        <DialogButton form=editFormBooking class="btn-submit" Type="Syncfusion.Blazor.Popups.ButtonType.Submit" IsPrimary="false" Content="Xác nhận"></DialogButton>
    </DialogButtons>
</SfDialog>

<SfDialog Target="#target" MinHeight="70%" Width="800px" Height="100%" class="dialog-create-employee" IsModal="true" ShowCloseIcon="true" @bind-Visible="_modalAddpet">
    <DialogTemplates>
        <Header><span class="title">Thêm thú cưng</span></Header>
        <Content>
            <EditForm id="editForm" Model="@_modelPet" OnValidSubmit="@OnFormPet">
                <DataAnnotationsValidator />
                <div class="form-group row">
                    <div class="col-lg-12">
                            <div class="card ">
                                <div class="card-body">
                                    <h5>Nhập Thông Tin Thú Cưng</h5>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="petName" class="col-form-label">Tên Thú Cưng</label>
                                        <SfTextBox Placeholder="Tên thú cưng" @bind-Value="_modelPet.Name" />
                                        <CustomValidationMessage style="color: red;" For="@(() => _modelPet.Name)" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="petType" class="col-form-label">Loại Thú Cưng</label>
                                            <SfComboBox TItem="EntityVeternayPetType" TValue="string" PopupHeight="230px"
                                                    @bind-Value="@_modelPet.Species" DataSource="_petType">
                                                <ComboBoxFieldSettings Text="Name" Value="Name" />
                                                <DropDownListEvents TItem="EntityVeternayPetType" TValue="string" />
                                            </SfComboBox>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            s
                                            <label for="petBreed" class="col-form-label">Giống Loài</label>
                                        <SfTextBox Placeholder="Giống loài" @bind-Value="_modelPet.Breed" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="petAge" class="col-form-label">Tuổi</label>
                                        <SfNumericTextBox Placeholder="Tuổi" @bind-Value="_modelPet.Age" Min="0" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="petGender" class="col-form-label">Giới Tính</label>
                                            <SfComboBox TItem="OptionDual<string>" TValue="string" PopupHeight="230px"
                                                    @bind-Value="@_modelPet.Gender" DataSource="@BasicCodes.GenderOptions">
                                                <ComboBoxFieldSettings Text="@Text["TextEn", "TextVi"]" Value="Value" />
                                                <DropDownListEvents TItem="OptionDual<string>" TValue="string" />
                                            </SfComboBox>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="petNotes" class="col-form-label">Ghi Chú</label>
                                        <InputTextArea rows="3" class="form-control" @bind-Value="_modelPet.MedicalNotes" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>
                </div>

            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogEvents Closed="@OnModalClosedPet"></DialogEvents>
    <DialogButtons>
        <DialogButton form=editForm class="btn-submit" Type="Syncfusion.Blazor.Popups.ButtonType.Submit" IsPrimary="false" Content="Xác nhận"></DialogButton>
    </DialogButtons>
</SfDialog>

<div class="modern-wrapper">
    <div class="modern-breadcrumb">
        <div class="container-fluid">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><i class="fas fa-users me-2"></i>Khách hàng</li>
                    <li class="breadcrumb-item"><a href="/customer/list" title="Danh sách khách hàng">Danh sách khách hàng</a></li>
                    <li class="breadcrumb-item active">Thông tin</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container-fluid py-4" id="target">
        <div class="row g-4">
            <div class="col-xl-3 col-lg-4 col-md-5">
                <div class="profile-card">
                    <div class="profile-cover">
                        <div class="cover-image"></div>
                        <div class="avatar-wrapper">
                            @if (_model.Avatar == null)
                            {
                                <img class="profile-avatar" alt="default" src="/assets/images/employee-avata-default.jpg">
                                <div class="avatar-overlay">
                                    <i class="fas fa-camera"></i>
                                </div>
                            }
                            else
                            {
                                <img class="profile-avatar" alt="avatar" src="@_model.Avatar">
                                <div class="avatar-overlay">
                                    <i class="fas fa-camera"></i>
                                </div>
                            }
                        </div>
                        <label class="upload-label" for="fileInput">
                            <i class="fas fa-cloud-upload-alt me-2"></i>Tải ảnh lên
                        </label>
                        <InputFile id="fileInput" OnChange="OnUploadAvata" accept=".png, .jpg, .jpeg" />
                    </div>

                    <!-- Profile Info -->
                    <div class="profile-info">
                        <h4 class="profile-name">@_model.FullName</h4>

                        <div class="info-divider"></div>

                        <div class="profile-details">
                            <div class="detail-item">
                                <i class="fas fa-id-card text-primary"></i>
                                <div class="detail-content">
                                    <span class="detail-label">ID</span>
                                    <span class="detail-value">@_model.Id</span>
                                </div>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-toggle-on text-success"></i>
                                <div class="detail-content">
                                    <span class="detail-label">Trạng thái</span>
                                    <span class="badge bg-success-soft text-success">Hoạt động</span>
                                </div>
                            </div>
                        </div>

                        <div class="text-muted small mt-3 px-3">
                            <i class="fas fa-info-circle me-1"></i>
                            Định dạng: .png, .jpg, .jpeg | Tối đa: 5MB
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-9 col-lg-8 col-md-7">
                <div class="content-card">
                    <SfTab @bind-SelectedItem="@_indexTab" CssClass="modern-tabs">
                        <TabEvents Selected="OnTabSelected" Selecting="OnSelecting"></TabEvents>
                        <TabItems>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="THÔNG TIN CƠ BẢN"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    <EditForm Model="@_model">
                                        <div class="tab-content-wrapper">
                                            <div class="section-header">
                                                <div class="d-flex align-items-center">
                                                    <div class="section-icon">
                                                        <i class="fas fa-address-card"></i>
                                                    </div>
                                                    <h5 class="section-title mb-0">Thông tin cơ bản</h5>
                                                </div>
                                                <div class="section-actions">
                                                    @if (_modalVisibleBasicInformation)
                                                    {
                                                        <button type="button" class="btn btn-icon btn-success"
                                                                @onclick="OnFormPet"
                                                                title="Lưu">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-icon btn-secondary"
                                                                @onclick="UndoUpdateEmployee"
                                                                title="Hủy">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-icon btn-primary"
                                                                @onclick="UpdateEmployee"
                                                                title="Chỉnh sửa">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <div class="form-section">
                                                <div class="row g-4">
                                                    <!-- Họ và tên -->
                                                    <div class="col-md-6">
                                                        <div class="form-group-modern mt-2">
                                                            <label class="form-label">
                                                                <i class="fas fa-user text-primary me-2"></i>
                                                                @Text[field[nameof(EntityVeternayCustomer.FullName)]]
                                                            </label>
                                                            @if (_modalVisibleBasicInformation)
                                                            {
                                                                <SfTextBox Placeholder="@Text[field[nameof(EntityVeternayCustomer.FullName)]]"
                                                                           CssClass="modern-input"
                                                                           @bind-Value="_model.FullName" />
                                                            }
                                                            else
                                                            {
                                                                <div class="form-value">@_model.FullName</div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="form-group-modern mt-2">
                                                            <label class="form-label">
                                                                <i class="fas fa-phone text-primary me-2"></i>
                                                                @Text[field[nameof(EntityVeternayCustomer.Phone)]]
                                                            </label>
                                                            @if (_modalVisibleBasicInformation)
                                                            {
                                                                <SfTextBox Placeholder="Điện thoại"
                                                                           CssClass="modern-input"
                                                                           @bind-Value="_model.Phone" />
                                                            }
                                                            else
                                                            {
                                                                <div class="form-value">
                                                                    <i class="fas fa-phone-alt me-2 text-muted"></i>
                                                                    @_model.Phone
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group-modern mt-2">
                                                            <label class="form-label">
                                                                <i class="fas fa-id-card text-primary me-2"></i>
                                                                @Text[field[nameof(EntityVeternayCustomer.CitizenID)]]
                                                            </label>
                                                            @if (_modalVisibleBasicInformation)
                                                            {
                                                                <SfTextBox Placeholder="@Text[field[nameof(EntityVeternayCustomer.CitizenID)]]"
                                                                           CssClass="modern-input"
                                                                           @bind-Value="_model.CitizenID" />
                                                            }
                                                            else
                                                            {
                                                                <div class="form-value">
                                                                    @(_model.CitizenID ?? Text["CCCD/CMND not updated", "Chưa cập nhật"])
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group-modern mt-2">
                                                            <label class="form-label">
                                                                <i class="fas fa-calendar text-primary me-2"></i>
                                                                @Text[field[nameof(EntityVeternayCustomer.DateOfBirth)]]
                                                            </label>
                                                            @if (_modalVisibleBasicInformation)
                                                            {
                                                                <SfDatePicker TValue="DateTime?"
                                                                              ShowClearButton="true"
                                                                              CssClass="modern-input"
                                                                              Format="@Text["MMM/dd/yyyy", "dd/MM/yyyy"]"
                                                                              @bind-Value="@_model.DateOfBirth"></SfDatePicker>
                                                            }
                                                            else
                                                            {
                                                                <div class="form-value">
                                                                    @(_model.DateOfBirth != null
                                                                                                                                    ? Text[_model.DateOfBirth.Value.ToString("MM/dd/yyyy"), _model.DateOfBirth.Value.ToString("dd/MM/yyyy")]
                                                                                                                                    : Text["Date of birth not updated!", "Chưa cập nhật"])
                                                            </div>
                                                                                                                        }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </EditForm>
                                </ContentTemplate>
                            </TabItem>

                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="DANH SÁCH ĐĂNG KÝ"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    <div class="tab-content-wrapper">
                                        <div class="section-header">
                                            <div class="d-flex align-items-center">
                                                <div class="section-icon">
                                                    <i class="fas fa-address-card"></i>
                                                </div>
                                                <div>
                                                    <h5 class="section-title mb-0">Danh sách đăng ký</h5>
                                                    <small class="text-muted">Quản lý thông tin đăng ký của khách hàng</small>
                                                </div>
                                            </div>
                                            <div class="section-actions">
                                                <button type="button" class="btn btn-primary btn-add-pet"
                                                        @onclick="OpenAddPetBooking">
                                                    <i class="fas fa-plus me-2"></i>Thêm phiếu đăng ký
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="app-content-body" style="overflow:auto" id="target">
                                        <div class="container-fluid" style="overflow:auto">
                                            <SfGrid AllowTextWrap="true" ID="Grid" @ref="_grid" EnableHover="true" AllowResizing="true" DataSource="@_dataSource" AllowPaging="true" AllowFiltering="true" AllowSorting="true"
                                                    EnableAdaptiveUI="false" AllowExcelExport="true" AllowPdfExport="true" ShowColumnChooser="true" EnableVirtualization="false" Height="100%">
                                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                                <GridTextWrapSettings WrapMode="WrapMode.Content"></GridTextWrapSettings>
                                                <GridPageSettings PageSize="50"></GridPageSettings>
                                                <GridColumns>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.Code) HeaderText="@Text["Code", "Mã"]" Width="160">
                                                    </GridColumn>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.Customer.FullName) HeaderText="@Text["Name Service", "Tên đăng ký"]" Width="160">
                                                        <Template>
                                                            @{
                                                                var item = (context as EntityVeternayBooking);
                                                            }
                                                            <a href="/customer/profile/@item.Customer.Guid">@item.Customer.FullName</a>
                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.BookingServices) HeaderText="@Text["Service", "Dịch vụ đăng ký"]" Width="160">
                                                        <Template>
                                                            @{
                                                                var item = (context as EntityVeternayBooking);
                                                            }
                                                            @if (item.BookingServices != null)
                                                            {
                                                                <ul class="list-group mb-3">
                                                                    @foreach (var service in item.BookingServices)
                                                                    {
                                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                            <span>@service.TitleService - @service.Price.ToString("N0") đ</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.GuidPet) HeaderText="@Text["Pet", "Thú cưng"]" Width="160">
                                                        <Template>
                                                            @{
                                                                var item = (context as EntityVeternayBooking);
                                                                var pet = _model.Pets.FirstOrDefault(x => x.Guid == item.GuidPet); 
                                                            }
                                                            <p>@pet.Name</p>
                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.TotalAmount) HeaderText="@Text["TotalAmount", "Tổng phí"]" Width="160">
                                                    </GridColumn>
                                                    <GridColumn Field=@nameof(EntityVeternayBooking.Notes) HeaderText="@Text[field[nameof(EntityVeternayBooking.Notes)]]" Width="160"></GridColumn>
                                                    <GridColumn HeaderText="@Text["Functions", "Chức năng"]" Width="110" TextAlign="TextAlign.Right">
                                                        <Template>
                                                            @{
                                                                var item = (context as EntityVeternayBooking);
                                                                <SfDropDownButton CssClass="e-caret-hide float-right" style="padding-left: 13px;" IconCss="fas fa-ellipsis-v">
                                                                    <DropDownMenuItems>
                                                                        <DropDownButtonEvents ItemSelected="SelectedTask"></DropDownButtonEvents>
                                                                        <DropDownMenuItem Id="@(item.Id.ToString())" Text="Sửa"></DropDownMenuItem>
                                                                        <DropDownMenuItem Id="@(item.Id.ToString())" Text="Xóa"></DropDownMenuItem>
                                                                    </DropDownMenuItems>
                                                                </SfDropDownButton>
                                                            }
                                                        </Template>
                                                    </GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        </div>
                                    </div>
                                </ContentTemplate>
                            </TabItem>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="DANH SÁCH THÚ CƯNG"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    <div class="tab-content-wrapper">
                                        <div class="section-header">
                                            <div class="d-flex align-items-center">
                                                <div class="section-icon">
                                                    <i class="fas fa-paw"></i>
                                                </div>
                                                <div>
                                                    <h5 class="section-title mb-0">Danh sách thú cưng</h5>
                                                    <small class="text-muted">Quản lý thông tin thú cưng của khách hàng</small>
                                                </div>
                                            </div>
                                            <div class="section-actions">
                                                <button type="button" class="btn btn-primary btn-add-pet"
                                                        @onclick="OpenAddPetModal">
                                                    <i class="fas fa-plus me-2"></i>Thêm thú cưng
                                                </button>
                                            </div>
                                        </div>
                                        @if (_model.Pets != null && _model.Pets.Any())
                                        {
                                            <div class="pets-grid">
                                                @foreach (var pet in _model.Pets.Where(p => !p.IsDeleted))
                                                {
                                                    <EditForm Model="pet">
                                                        <div class="pet-card">
                                                            <div class="pet-card-header">
                                                                <div class="pet-basic-info">
                                                                    <h6 class="pet-name">@pet.Name</h6>
                                                                    <span class="pet-species">@pet.Species</span>
                                                                </div>
                                                                <div class="pet-actions">
                                                                    @if (_modelVisibleAddPet && pet == _modelPet)
                                                                    {
                                                                        <button type="button" class="btn btn-icon btn-success"
                                                                                @onclick="OnFormPet"
                                                                                title="Lưu">
                                                                            <i class="fas fa-check"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-icon btn-secondary"
                                                                                @onclick="UndoUpdatePet"
                                                                                title="Hủy">
                                                                            <i class="fas fa-times"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn-pet-action btn-edit"
                                                                                @onclick="() => OpenEditPetModal(pet)"
                                                                                title="Chỉnh sửa">
                                                                            <i class="fas fa-edit"></i>
                                                                        </button>
                                                                        <button type="button" class="btn-pet-action btn-delete"
                                                                                @onclick="() => DeletePet(pet.Id)"
                                                                                title="Xóa">
                                                                            <i class="fas fa-trash-alt"></i>
                                                                        </button>
                                                                    }

                                                                </div>
