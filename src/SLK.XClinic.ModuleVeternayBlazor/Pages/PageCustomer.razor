    private EntityVeternayCustomer _model = new();
    private SfUploader _uploader;
    private SfUploader _uploaderDocument;
    private IEnumerable<EntityVeternayCustomer> _dataSourse;
    private List<EntityVeternayCustomer> _displaySourse = new();
    private List<OptionItem<Guid>> _optOffices = new();
    private List<OptionItem<Guid>> _optEmployees = new();
    private List<OptionItem<Guid>> _optCars = new();
    private List<OptionItem<Guid>> _optJob = new();
    private List<OptionItem<Guid>> _optPlace = new();
    private bool _modelVisibleAddPet = false;
    private List<EntityVeternayPetType> _petType = new();
    private EntityveternayPet _modelPet = new();
    private bool _modalAddpet = false;
    private EntityVeternayBooking _modelBooking = new();
    private bool _modalVisible = false;
    private EntityveternayPet _selectedPets;
    private List<ModelService> _selectedServicesList = new();
    private Guid[] _selectedService = Array.Empty<Guid>();
    private Guid _selectedPet = Guid.Empty;
    public decimal _price { get; set; } = 0;
    public int _normail { get; set; } = 0;
    private decimal _totalPrice = 0;
    private List<EntityveternayPet> _optCusPet = new();
    private List<ModelService> _optService = new();
    private EntityVeternayCustomer _selectedCustomer;
    private SfGrid<EntityVeternayBooking> _grid;
    private IEnumerable<EntityVeternayBooking> _dataSource = new List<EntityVeternayBooking>();
    #endregion

    #region events
    protected override async Task OnInitializedAsync()
    {
        _ = swal.Loading("Nạp thông tin ..");

        var curentTab = _navManager.Uri.GetAfter("#");
        switch (curentTab)
        {
            case "thong-tin-co-ban":
                _indexTab = 0;
                break;
            case "document":
                _indexTab = 1;
                break;
        }

        await RereshData();
    }

    private void UpdateEmployee()
    {
        _modalVisibleBasicInformation = true;
    }

    private void UndoUpdateEmployee()
    {
        _modalVisibleBasicInformation = false;
    }
    private void UndoUpdatePet()
    {
        _modelVisibleAddPet = false;
    }
    private void Professional_UpdateEmployee()
    {
        _modalVisibleRelativeInformation = true;
    }

    private void Professional_UndoUpdateEmployee()
    {
        _modalVisibleRelativeInformation = false;
    }

    private void DocumentClose()
    {
        _modalVisibleDocument = false;
        fileDocument = string.Empty;
        _folderName = string.Empty;
        _nameFile = string.Empty;
    }
    #endregion
    #region methods
    private async Task RereshData()
    {
        var rsp = await AppStatic.CallApi(() => _svc.Get(guid));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        var petType = await AppStatic.CallApi(() => _svc.GetListPetsType());

        if (!petType.Success)
        {
            _ = swal.Error(petType.Message, "Lỗi khi tải danh sách loại thú cưng!");
            return;
        }
        var rsp3 = await AppStatic.CallApi(() => _svcBooking.GetList());
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        _dataSource = rsp3.Items.Where(x => x.GuidCustomer == guid).ToList();
        _petType = petType.Items.ToList();
        _model = rsp.Item;
        await swal.Close();
        StateHasChanged();
    }
    private async Task OnUploadAvata(InputFileChangeEventArgs args)
    {
        var resuft = await UploadHelper.ImageBase64(args.File);

        if (resuft.Item1 == "error")
        {
            _ = swal.Error(resuft.Item2, "Lỗi!");
            return;
        }
        else if (resuft.Item1 == "success")
        {
            _model.Avatar = resuft.Item2;

            _ = swal.Loading("Lưu thông tin ..");

            var rsp = await AppStatic.CallApi(() => _svc.Save(_model));

            if (!rsp.Success)
            {
                _ = swal.Error(rsp.Message, "Lỗi!");
                return;
            }

            _ = swal.Alert("Thông tin đã được lưu!");
            StateHasChanged();
        }
    }

    private void OnSelecting(SelectingEventArgs args)
    {
        if (args.IsSwiped)
        {
            args.Cancel = true;
        }
    }

    private void OnUploadDocument(SuccessEventArgs args)
    {
        var customHeader = new string[] { };
        customHeader = args.Response.Headers.Split("\r\n".ToCharArray(), options: StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < customHeader.Length; i++)
        {
            var key = customHeader[i].GetBefore(":");
            var value = customHeader[i].GetAfter(":").Trim();
            if (key == "relativepath")
            {
                _typeFile = value.GetAfterLast(".");
                _nameFile = value;
            }
        }
        StateHasChanged();
    }

    private async void OnFormSubmitBasicInformation()
    {
        _modalVisibleBasicInformation = false;
        var rsp = await AppStatic.CallApi(() => _svc.Save(_model));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        await RereshData();

        _ = swal.Alert(Text["Saved", "Thông tin đã được cập nhật "]);
    }
    private async Task OnFormPet()
    {

        _modelPet.EntityVeternayCustomerId = _model.Id;
        _modelPet.GuidCustomer = _model.Guid;

        var rsp = await AppStatic.CallApi(() => _svc.SavePet(_modelPet));
        _modelPet = new();
        _modalAddpet = false;
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }

        _ = swal.Alert(Text["Saved", "Thông tin đã được cập nhật "]);

        await RereshData();

    }
    public async Task  OpenAddPetModal()
    {
        _modalAddpet = true;

    }
    private void OnModalClosedPet(Object args)
    {
        _modalAddpet = false;
        _modelPet = new();
    }
    public async void OpenEditPetModal(EntityveternayPet pet)
    {
        _modelPet = pet;
        _modelVisibleAddPet = true;



    }
    private async void DeletePet(int id)
    {
        var confirm = await swal.ConfirmDelete("Xác nhận xoá thông tin");
        if (!confirm) return;

        _ = swal.Loading("Đang xóa ..");

        var rsp = await AppStatic.CallApi(() => _svc.DeletePet(id));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }

        await RereshData();
        StateHasChanged();
    }
    private async void OnFormSubmitProfessionalInformation()
    {
        _modalVisibleRelativeInformation = false;

        var rsp = await AppStatic.CallApi(() => _svc.Save(_model));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        await RereshData();

        _ = swal.Alert(Text["Saved", "Thông tin đã được cập nhật "]);
        StateHasChanged();
    }

    private void OpenFileNewTab(string file)
    {
        jSRuntime.InvokeVoidAsync("OpenFileNewTab", file);
    }

    public async void OnTabSelected()
    {
        var curentUri = _navManager.Uri.GetBefore("#");
        switch (_indexTab)
        {
            case 0:
                curentUri += "#thong-tin-co-ban";
                break;
            case 1:
                curentUri += "#document";
                break;
        }
        await JSRuntime.InvokeVoidAsync("update_url", curentUri);
    }
    private async Task ListService()
    {
        var rspService = await _svc.GetListService();
        _optService = rspService.ToList();
        StateHasChanged();
    }
    public async Task OpenAddPetBooking()
    {
        _selectedCustomer = _model;
        _modalVisible = true;
        _modelBooking = new();
        _selectedPet = Guid.Empty;
        _selectedPets = null;
        _selectedService = Array.Empty<Guid>();
        _selectedServicesList.Clear();
        _totalPrice = 0;

        await ListService();
        StateHasChanged();
    }
    private async Task OnFormSubmitBooking()
    {
        try
        {
            _ = swal.Loading("Đang lưu thông tin...");

            if (_selectedPet == Guid.Empty)
            {
                await swal.Error("Vui lòng chọn thú cưng!");
                return;
            }

            if (!_selectedServicesList.Any())
            {
                await swal.Error("Vui lòng chọn ít nhất một dịch vụ!");
                return;
            }

            _modelBooking.TotalAmount = _totalPrice;
            _modelBooking.GuidCustomer = _model.Guid;
            _modelBooking.GuidPet = _selectedPet;
            _modelBooking.CustomerId = _model.Id;

            _modelBooking.BookingServices = _selectedServicesList.Select(x => new EntityVeternayBookingService
            {
                Guid = Guid.NewGuid(),
                GuidBooking = _modelBooking.Guid != Guid.Empty ? _modelBooking.Guid : Guid.NewGuid(),
                Price = x.Price,
                TitleService = x.Name,
                GuidService = x.Guid
            }).ToList();

            if (_modelBooking.Guid == Guid.Empty)
            {
                _modelBooking.Guid = Guid.NewGuid();
            }

            var rsp = await AppStatic.CallApi(() => _svcBooking.Save(_modelBooking));

            if (!rsp.Success)
            {
                await swal.Error(rsp.Message);
                return;
            }

            await swal.Alert(_modelBooking.Id > 0 ? "Cập nhật thành công!" : "Thêm mới thành công!");

            _modalVisible = false;
            _modelBooking = new();
            _selectedPet = Guid.Empty;
            _selectedPets = null;
            _selectedService = Array.Empty<Guid>();
            _selectedServicesList.Clear();
            _totalPrice = 0;

            await RereshData();
        }
        catch (Exception ex)
        {
            await swal.Error($"Lỗi: {ex.Message}");
        }
    }
    private void OnPetsChanged(ChangeEventArgs<Guid, EntityveternayPet> args)
    {
        if (_selectedCustomer?.Pets != null)
        {
            _selectedPets = _selectedCustomer.Pets.FirstOrDefault(x => x.Guid == args.Value);
        }
        StateHasChanged();
    }
    private void OnServiceChanged(MultiSelectChangeEventArgs<Guid[]> args)
    {
        _selectedService = args.Value ?? Array.Empty<Guid>();
        UpdateService();
        CalculateTotalPrice();
        StateHasChanged();
    }

    private void UpdateService()
    {
        _selectedServicesList.Clear();
        foreach (var item in _selectedService)
        {
            var service = _optService.FirstOrDefault(x => x.Guid == item);
            if (service != null)
            {
                _selectedServicesList.Add(service);
            }
        }
    }

    private void CalculateTotalPrice()
    {
        _totalPrice = _selectedServicesList.Sum(s => s.Price);
    }
    private void OnModalClosedBooking(Object args)
    {
        _modelBooking = new EntityVeternayBooking();
    }
    private async Task SelectedTask(MenuEventArgs e)
    {
        string text = e.Item.Text.ToLower();
        int id = Convert.ToInt32(e.Item.Id);
        if (text == "sửa")
            await Modify(id);
        if (text == "xóa")
            Delete(id);
    }
    private async Task Modify(int id)
    {
        try
        {
            _ = swal.Loading("Đang tải thông tin...");

            // Lấy booking item từ datasource
            var item = _dataSource.FirstOrDefault(t => t.Id == id);
            if (item == null)
            {
                await swal.Error("Không tìm thấy thông tin đăng ký");
                return;
            }

            // Gán thông tin booking vào model
            _modelBooking = new EntityVeternayBooking
            {
                Id = item.Id,
                Guid = item.Guid,
                Code = item.Code,
                GuidCustomer = item.GuidCustomer,
                CustomerId = item.CustomerId,
                GuidPet = item.GuidPet,
                TotalAmount = item.TotalAmount,
                Notes = item.Notes,
                BookingServices = item.BookingServices
            };

            _selectedCustomer = _model; 

            _selectedPet = item.GuidPet;
            _selectedPets = _selectedCustomer?.Pets?.FirstOrDefault(p => p.Guid == item.GuidPet);

            if (!_optService.Any())
            {
                await ListService();
            }

            if (item.BookingServices?.Any() == true)
            {
                _selectedService = item.BookingServices.Select(bs => bs.GuidService).ToArray();

                _selectedServicesList.Clear();
                foreach (var svcGuid in _selectedService)
                {
                    var service = _optService.FirstOrDefault(s => s.Guid == svcGuid);
                    if (service != null)
                    {
                        _selectedServicesList.Add(service);
                    }
                }

                CalculateTotalPrice();
            }
            else
            {
                _selectedService = Array.Empty<Guid>();
                _selectedServicesList.Clear();
                _totalPrice = 0;
            }

            await swal.Close();
            _modalVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await swal.Error($"Lỗi: {ex.Message}");
        }
    }
    private async void Delete(int id)
    {
        var confirm = await swal.ConfirmDelete("Xác nhận xoá thông tin");
        if (!confirm) return;

        _ = swal.Loading("Đang xóa ..");

        var rsp = await AppStatic.CallApi(() => _svcBooking.Delete(id));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }

        await RereshData();
        StateHasChanged();
    }
    private string TimeAgo(DateTime date)
    {
        TimeSpan timeSince = DateTime.Now.Subtract(date);
        if (timeSince.TotalMinutes < 1) return Text["Just now", "Ngay bây giờ"];
        if (timeSince.TotalMinutes < 2) return Text["1 minute ago", "1 phút trước"];
        if (timeSince.TotalMinutes < 60) return string.Format("{0} " + Text["minutes ago", "phút trước"], timeSince.Minutes);
        if (timeSince.TotalMinutes < 120) return Text["1 hour ago", "1 giờ trước"];
        if (timeSince.TotalHours < 24) return string.Format("{0} " + Text["hours ago", "giờ trước"], timeSince.Hours);
        if (timeSince.TotalDays < 2) return Text["Yesterday", "Hôm qua"];
        if (timeSince.TotalDays < 7) return string.Format("{0}" + Text["days ago", "ngày trước"], timeSince.Days);
        if (timeSince.TotalDays < 14) return Text["Last week", "Tuần trước"];
        if (timeSince.TotalDays < 21) return Text["2 last week", "2 tuần trước"];
        if (timeSince.TotalDays < 28) return Text["3 last week", "3 tuần trước"];
        if (timeSince.TotalDays < 60) return Text["Last month", "Tháng trước"];
        if (timeSince.TotalDays < 365) return string.Format("{0} " + Text["months ago", "tháng trước"], Math.Round(timeSince.TotalDays / 30));
        if (timeSince.TotalDays < 730) return Text["Last year", "Năm trước"];
        return string.Format("{0} " + Text["years ago", "năm trước"], Math.Round(timeSince.TotalDays / 365));
    }
