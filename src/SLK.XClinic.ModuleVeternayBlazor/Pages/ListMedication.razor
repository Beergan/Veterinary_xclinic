@page "/list/medication"
@inject Microsoft.JSInterop.IJSRuntime jSRuntime
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Inputs
@using System.Linq
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.DropDowns
@using System.Data
@using Syncfusion.XlsIO
@using System.IO

@using MudBlazor
@using Syncfusion.Blazor.Calendars
@attribute [Authorize]
@inject ISettingMedicationService _svc
@inject ISweetAlertService swal
@inject ITextTranslator Text
@inject FieldExtractor<EntityVeternayMedication> field


<SfDialog Target="#target" MinHeight="70%" Width="400px" Height="400px" class="dialog-create-employee" IsModal="true" ShowCloseIcon="true" @bind-Visible="_modalVisible">
    <DialogTemplates>
        <Header><span class="title">@_modalTitle</span></Header>
        <Content>
            <EditForm id="editForm" Model="@_model" OnValidSubmit="@OnFormSubmit">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <MudText Typo="Typo.h6" Class="mb-3">Thông tin cơ bản</MudText>
                    <MudTextField @bind-Value="_model.MedicationCode"
                                  Label="Mã thuốc"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"></MudTextField>
                    <CustomValidationMessage For="@(() => _model.MedicationCode)" />
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Tên loại thuốc"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"></MudTextField>
                    <CustomValidationMessage For="@(() => _model.Name)" />
                    <MudText Typo="Typo.h6" Class="mb-3">Danh mục thuốc</MudText>
                    <SfComboBox CssClass="mb-2" TItem="EntityVeternayMedicationCategory" TValue="int?"
                                @bind-Value="_model.CategoryId"
                                DataSource="@(_optCategory ?? new List<EntityVeternayMedicationCategory>())" Placeholder="Chọn danh mục"
                                PopupHeight="230px" Width="100%" AllowFiltering="true">
                        <ComboBoxFieldSettings Text="Name" Value="Id" />
                    </SfComboBox>
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.Type"
                                          Label="Dạng thuốc"
                                          Variant="Variant.Outlined"></MudTextField>
                            <CustomValidationMessage For="@(() => _model.Type)" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.UnitType"
                                          Label="Đơn vị tính"
                                          Variant="Variant.Outlined"></MudTextField>
                            <CustomValidationMessage For="@(() => _model.UnitType)" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal"
                                             @bind-Value="_model.ImportPrice"
                                             Label="Giá nhập"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End"
                                             AdornmentText="đ"
                                             Format="N0" />
                            <CustomValidationMessage For="@(() => _model.ImportPrice)" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal"
                                             @bind-Value="_model.Price"
                                             Label="Giá bán"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End"
                                             AdornmentText="đ"
                                             Format="N0" />
                            <CustomValidationMessage For="@(() => _model.Price)" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int"
                                             @bind-Value="_model.StockQuantity"
                                             Label="Số lượng tồn kho"
                                             Variant="Variant.Outlined" />
                            <CustomValidationMessage For="@(() => _model.StockQuantity)" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.RecommendedDosage"
                                          Label="Liều lượng khuyến cáo"
                                          Variant="Variant.Outlined"></MudTextField>
                            <CustomValidationMessage For="@(() => _model.RecommendedDosage)" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.h6" Class="mb-3 mt-4">Mô tả chi tiết</MudText>
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Mô tả"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="mb-4"></MudTextField>
                    <CustomValidationMessage For="@(() => _model.Description)" />

                    <!-- TRẠNG THÁI -->
                    <MudSwitch @bind-Value="_model.IsDeleted"
                               Color="Color.Success"
                               Label="@(!_model.IsDeleted ? "Đã vô hiệu hóa" : "Đang hoạt động")"
                               Class="mt-2" />
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogEvents Closed="@OnModalClosed"></DialogEvents>
    <DialogButtons>
        <DialogButton form=editForm class="btn-submit" Type="Syncfusion.Blazor.Popups.ButtonType.Submit" IsPrimary="false" Content="Xác nhận"></DialogButton>
    </DialogButtons>
</SfDialog>
<div class="app-content-wrapper">
    @if (active)
    {
        <div class="app-content-head" style="height: auto">
            <div class="row" style="padding: 0 0 0 5px">
                <div class="col-12">
                    <ol class="breadcrumb">
                        <li>Loại thuốc</li>
                        <li style="color: #777">&nbsp; / &nbsp;</li>
                        <li class="active text-primary"> Danh sách</li>
                    </ol>
                </div>
                <div class="col-md-4 col-lg-3 d-none d-md-block">
                    <div class="input-group">
                        <input type="text" class="form-control" style="height: 31px;" placeholder="@Text["Search...", "Tìm kiếm..."]" @bind="_filterSearch" @bind:event="oninput" @onkeyup="OnChange" />
                        <div class="input-group-append">
                            <span class="input-group-text bg-white" style="height: 31px;" id="basic-addon2"><i class="fas fa-search"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-9 text-right">
                    <div class="btn-group pr-0">
                        <button class="btn btn-light float-right newplus mr-2" @onclick="NewEmployee_Click"><span class="fas fa-plus"></span> @Text["Medication", "Loại thuốc"]</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="app-content-body" style="overflow:auto" id="target">
            <div class="container-fluid" style="overflow:auto">
                <SfGrid AllowTextWrap="true" ID="Grid" @ref="_grid" EnableHover="true" AllowResizing="true" DataSource="@_displaySource" AllowPaging="true" AllowFiltering="true" AllowSorting="true"
                        EnableAdaptiveUI="false" AllowExcelExport="true" AllowPdfExport="true" ShowColumnChooser="true" EnableVirtualization="false" Height="100%">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                    <GridTextWrapSettings WrapMode="WrapMode.Content"></GridTextWrapSettings>
                    <GridPageSettings PageSize="50"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field=@nameof(EntityVeternayMedication.MedicationCode) HeaderText="@Text[field[nameof(EntityVeternayMedication.MedicationCode)]]" Width="160">
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.Name) HeaderText="@Text[field[nameof(EntityVeternayMedication.Name)]]" Width="160">
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.Category.Name) HeaderText="@Text["Danh mục"]" Width="160">
                    <Template>
                                @{
                                    var item = (context as EntityVeternayMedication);
                                    <p>@item.Category.Name</p>
                                }
                    </Template>
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.Type) HeaderText="@Text[field[nameof(EntityVeternayMedication.Type)]]" Width="160">
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.ImportPrice) HeaderText="@Text[field[nameof(EntityVeternayMedication.ImportPrice)]]" Width="160">
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.Price) HeaderText="@Text[field[nameof(EntityVeternayMedication.Price)]]" Width="160">
                        </GridColumn>
                        <GridColumn Field=@nameof(EntityVeternayMedication.Description) HeaderText="@Text[field[nameof(EntityVeternayMedication.Description)]]" Width="160"></GridColumn>
                        <GridColumn HeaderText="@Text["Functions", "Chức năng"]" Width="110" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var item = (context as EntityVeternayMedication);
                                    <SfDropDownButton CssClass="e-caret-hide float-right" style="padding-left: 13px;" IconCss="fas fa-ellipsis-v">
                                        <DropDownMenuItems>
                                            <DropDownButtonEvents ItemSelected="SelectedTask"></DropDownButtonEvents>
                                            <DropDownMenuItem Id="@(item.Id.ToString())" Text="Sửa"></DropDownMenuItem>
                                            <DropDownMenuItem Id="@(item.Id.ToString())" Text="Xóa"></DropDownMenuItem>
                                        </DropDownMenuItems>
                                    </SfDropDownButton>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
    }
</div>

@code {
    #region vavariables
    [Parameter]
    public decimal _price { get; set; } = 0;
    public int _normail { get; set; } = 0;
    public string str { get; set; }
    private SfGrid<EntityVeternayMedication> _grid;
    private IEnumerable<EntityVeternayMedication> _dataSource = new List<EntityVeternayMedication>();
    private List<EntityVeternayMedication> _displaySource = new();
    private List<OptionItem<Guid>> _optOffices = new();
    private List<OptionItem<Guid>> _optJob = new();
    private EntityVeternayMedication _model = new();
    private bool active = false;
    private bool _modalVisible = false;
    private bool _filter = false;
    private string _modalTitle;
    private bool _add_Pets = false;
    private string _filterSearch;
    private List<EntityVeternayMedicationCategory> _optCategory = new();
    public int ? Id_Category { get; set; }
    #endregion
    #region events
    private void OnPriceChanged(decimal value)
    {
        _price = value;
        _model.Price = value;
    }
    protected override async Task OnInitializedAsync()
    {
        _ = swal.Loading("Nạp thông tin ..");


        await RereshData();
        StateHasChanged();
    }

    private void NewEmployee_Click()
    {
        _modalTitle = "Thêm loại thuốc";
        _modalVisible = true;
        _model.IsDeleted = true;
    }

    private void OnModalClosed(Object args)
    {
        _model = new EntityVeternayMedication();
    }
    #endregion

    #region methods
    private async Task RereshData()
    {

        var rsp = await AppStatic.CallApi(() => _svc.GetList());
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        var rsp2 = await AppStatic.CallApi(() => _svc.GetListCategory());
        if (!rsp2.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        _model.IsDeleted = true;
        active = true;
        _dataSource = rsp.Items;
        _optCategory = rsp2.Items.ToList();
        _displaySource = _dataSource.OrderByDescending(x => x.Id).ToList();

        await swal.Close();
        StateHasChanged();
    }

    private async void OnFormSubmit()
    {
        _modalVisible = false;
        _ = swal.Loading("Lưu thông tin..");
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _ = swal.Error("Vui lòng điền đầy đủ thông tin thuốc bắt buộc (*).");
            return;
        }
        var rsp = await AppStatic.CallApi(() => _svc.Save(_model));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        await RereshData();
    }

    private void OnChange()
    {
        var query = _dataSource.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_filterSearch))
            query = query.Where(w => w.Name.ToLower().Contains(_filterSearch.ToLower()));

        _displaySource = query.OrderByDescending(o => o.Id).ToList();
        StateHasChanged();
    }
  
    private async void Modify(int id)
    {
        var item = _dataSource.Single(t => t.Id == id);
        _model = item;

        _modalTitle = "Hiệu chỉnh loại thuốc";
        _modalVisible = true;

        await Task.CompletedTask;
    }

    private void SelectedTask(MenuEventArgs e)
    {
        string text = e.Item.Text.ToLower();
        int id = Convert.ToInt32(e.Item.Id);
        if (text == "sửa")
            Modify(id);
        if (text == "xóa")
            Delete(id);
    }
    private async void Delete(int id)
    {
        var confirm = await swal.ConfirmDelete("Xác nhận xoá thông tin");
        if (!confirm) return;

        _ = swal.Loading("Đang xóa ..");

        var rsp = await AppStatic.CallApi(() => _svc.Delete(id));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }

        await RereshData();
        StateHasChanged();
    }
    #endregion
}